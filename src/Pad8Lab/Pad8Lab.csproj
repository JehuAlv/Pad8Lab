<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>Pad8Lab</AssemblyName>
    <RootNamespace>Pad8Lab</RootNamespace>
    <Product>Pad8Lab</Product>
    <AssemblyTitle>Pad8Lab</AssemblyTitle>
    <Description>Custom firmware for 8BitDo controllers, starting with Bluetooth rumble and native Xbox (XInput) on the Ultimate 2C Wireless.</Description>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Pad8Lab.Core\Pad8Lab.Core.csproj" />
  </ItemGroup>

</Project>
